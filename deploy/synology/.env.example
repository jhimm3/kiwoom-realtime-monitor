# PostgreSQL
POSTGRES_DB=kiwoom_monitor
POSTGRES_USER=kiwoom_monitor
POSTGRES_PASSWORD=change-this-database-password

# 중앙 서버
MONITOR_SERVER_ACCESS_TOKEN=change-this-long-random-token
KIWOOM_MONITOR_PORT=8787
# Docker 재생성 뒤에도 DSM 역방향 프록시 peer를 고정한다. 두 값은 같은 대역이어야 한다.
KIWOOM_DOCKER_SUBNET=172.18.0.0/24
KIWOOM_DOCKER_GATEWAY=172.18.0.1
# 상세 서버/API 로그는 server-data/logs에서 날짜별 회전하며 이 일수만 보존합니다.
CENTRAL_SERVER_LOG_RETENTION_DAYS=14
KIWOOM_ENVIRONMENT=real
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
AUTONOMOUS_TOP20_ENABLED=1
# 모의계좌 읽기 전용 복구. 실전 키와 별도인 모의투자 키를 사용합니다.
MOCK_ACCOUNT_MONITOR_ENABLED=0
# 인증된 수동 API 요청만 모의주문으로 전송합니다. 후보 자동주문은 연결하지 않습니다.
MOCK_ORDER_TRANSPORT_ENABLED=0
KIWOOM_MOCK_APP_KEY=
KIWOOM_MOCK_SECRET_KEY=
MOCK_ACCOUNT_REF=
# 32바이트 이상. 계좌 ref를 계속 재사용하려면 DB와 별도로 함께 보호 백업한다.
ACCOUNT_IDENTITY_HMAC_KEY=
# 등록 명령으로 MOCK_ACCOUNT_REF를 받은 뒤 1로 켭니다.
ACCOUNT_IDENTITY_REGISTRY_ENABLED=0
MOCK_EXECUTION_RUN_ID=
# TOP20 저장 실패분은 server-data 볼륨의 이 파일에 남아 재시작 후 재시도됩니다.
TOP20_OUTBOX_PATH=/app/data/top20-index-outbox.json

# Yahoo 지연 시세 임시 수집원(5분봉·일봉)
EXTERNAL_MARKET_ENABLED=1
EXTERNAL_MARKET_POLL_SECONDS=300
EXTERNAL_MARKET_SYMBOLS=NASDAQ_FUTURES:MNQU26.CME,WTI_FUTURES:CLV26.NYM
EXTERNAL_MARKET_AUTO_ROLL_ENABLED=1
# 차월물 거래량 우위를 연속 2회 확인한 뒤 전환(5분 수집이면 약 10분 확인)
EXTERNAL_MARKET_ROLL_CONFIRMATIONS=2

# 네이버 뉴스 수집
NAVER_NEWS_CLIENT_ID=
NAVER_NEWS_CLIENT_SECRET=
NEWS_REFRESH_SECONDS=300
# 앱 선택과 무관한 NAVER query_set 수집. 기존 자격증명이 있으면 기본 ON입니다.
NEWS_QUERY_SET_ENABLED=true
NEWS_QUERY_SET=증권,코스피,코스닥,상장사,수주 계약,유상증자,인수합병,실적 전망,최대주주
NEWS_QUERY_SET_REFRESH_SECONDS=300
# 기사 목록 기록은 유지하고 NAS 원문 추출·규칙·자동 AI 처리만 제외할 언론사명/도메인
NEWS_PROCESSING_EXCLUDED_PROVIDERS=
# NAVER 공식 25,000회/일보다 낮은 24,000 hard limit. 두 scope 합계는 자동 clamp됩니다.
NEWS_REQUEST_HARD_LIMIT=24000
NEWS_WATCHLIST_REQUEST_LIMIT=8000
NEWS_QUERY_SET_REQUEST_LIMIT=16000
MARKET_EVENT_COLLECTION_ENABLED=true
# 0이면 최신 순위 저장은 유지하고 D1 불변 순위 이력만 중단합니다.
RESEARCH_OBSERVATION_HISTORY_ENABLED=true
# 주문을 만들지 않는 D4 후보 기록. 전략 수치는 실험값을 정한 뒤에만 켭니다.
SHADOW_CANDIDATE_ENABLED=0
SHADOW_CANDIDATE_CONFIG_JSON=
SHADOW_CANDIDATE_POLL_SECONDS=2
SHADOW_CANDIDATE_UNIVERSE_MAX_AGE_SECONDS=0
# 정확히 일치하는 저장 조건식 이름. 비우면 아래 부분문자열이 정확히 한 조건에만 맞을 때 사용한다.
HOT_COHORT_CONDITION_NAME=
HOT_COHORT_CONDITION_SUBSTRING=15%
# 0이면 새 영속 본문/AI 작업 실행을 멈추고 기존 요청형 분석 경로를 사용합니다.
NEWS_HISTORY_JOBS_ENABLED=true

# DART 공시(사용할 때만 1)
DART_ENABLED=0
DART_API_KEY=
DART_CACHE_PATH=/app/data/dart_corp_codes.json

# AI 원문 분석: 사용할 공급자의 키만 입력
NEWS_AI_PROVIDER=gemini
NEWS_AI_MODEL=gemini-3.5-flash-lite
NEWS_AI_DAILY_LIMIT=500
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
