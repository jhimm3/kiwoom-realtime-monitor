# PostgreSQL
POSTGRES_DB=kiwoom_monitor
POSTGRES_USER=kiwoom_monitor
POSTGRES_PASSWORD=change-this-database-password

# 중앙 서버
MONITOR_SERVER_ACCESS_TOKEN=change-this-long-random-token
KIWOOM_MONITOR_PORT=8787
KIWOOM_ENVIRONMENT=real
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
AUTONOMOUS_TOP20_ENABLED=1
# TOP20 저장 실패분은 server-data 볼륨의 이 파일에 남아 재시작 후 재시도됩니다.
TOP20_OUTBOX_PATH=/app/data/top20-index-outbox.json

# Yahoo 지연 시세 임시 수집원(5분봉·일봉)
EXTERNAL_MARKET_ENABLED=1
EXTERNAL_MARKET_POLL_SECONDS=300
EXTERNAL_MARKET_SYMBOLS=NASDAQ_FUTURES:MNQU26.CME,WTI_FUTURES:CLV26.NYM
EXTERNAL_MARKET_AUTO_ROLL_ENABLED=1
# 차월물 거래량 우위를 연속 2회 확인한 뒤 전환(5분 수집이면 약 10분 확인)
EXTERNAL_MARKET_ROLL_CONFIRMATIONS=2

# 네이버 뉴스 수집
NAVER_NEWS_CLIENT_ID=
NAVER_NEWS_CLIENT_SECRET=
NEWS_REFRESH_SECONDS=300

# DART 공시(사용할 때만 1)
DART_ENABLED=0
DART_API_KEY=
DART_CACHE_PATH=/app/data/dart_corp_codes.json

# AI 원문 분석: 사용할 공급자의 키만 입력
NEWS_AI_PROVIDER=gemini
NEWS_AI_MODEL=gemini-3.5-flash-lite
NEWS_AI_DAILY_LIMIT=500
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
