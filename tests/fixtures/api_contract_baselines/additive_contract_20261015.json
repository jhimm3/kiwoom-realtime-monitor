  "reviewed_additive_schemas": {
    "RamShadowSelectionUpdate": {
      "properties": {
        "expected_revision": {
          "type": "integer",
          "minimum": 0.0,
          "title": "Expected Revision"
        },
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Enabled"
        },
        "theme_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array",
              "maxItems": 32
            },
            {
              "type": "null"
            }
          ],
          "title": "Theme Ids"
        },
        "leadership_venue": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(KRX|NXT)$"
            },
            {
              "type": "null"
            }
          ],
          "title": "Leadership Venue"
        },
        "recording": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recording"
        },
        "stock_thesis": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stock Thesis"
        },
        "position_comparison": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Position Comparison"
        },
        "position_account_live": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Position Account Live"
        },
        "position_allocation": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Position Allocation"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "expected_revision"
      ],
      "title": "RamShadowSelectionUpdate"
    }
  },
  "route_insertions": [
    {
      "before": "/api/v1/settings/operations",
      "paths": [
        "/api/v1/research/ram-shadow/selection"
      ]
    },
    {
      "before": "/api/v1/kiwoom/query",
      "paths": [
        "/api/v1/research/ram-shadow/allocation-models"
      ]
    },
    {
      "before": "/api/v1/research/observations",
      "paths": [
        "/api/v1/research/ram-shadow/source-check",
        "/api/v1/research/ram-shadow"
      ]
    },
    {
      "before": "/api/v1/market/snapshots/{kind}",
      "paths": [
        "/api/v1/mock-automation/unfilled-population"
      ]
    }
  ]
}
