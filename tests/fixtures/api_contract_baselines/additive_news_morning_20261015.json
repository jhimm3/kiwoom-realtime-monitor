  "reviewed_additive_schemas": {
    "AccountSelection": {
      "properties": {
        "account_id": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Account Id"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "account_id"
      ],
      "title": "AccountSelection"
    },
    "Update": {
      "properties": {
        "expected_revision": {
          "type": "integer",
          "minimum": 0.0,
          "title": "Expected Revision"
        },
        "enabled": {
          "type": "boolean",
          "title": "Enabled"
        },
        "time": {
          "type": "string",
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
          "title": "Time"
        },
        "provider": {
          "type": "string",
          "pattern": "^(chatgpt_plan|openai)$",
          "title": "Provider"
        },
        "model": {
          "type": "string",
          "maxLength": 100,
          "minLength": 1,
          "title": "Model"
        },
        "reasoning_effort": {
          "type": "string",
          "pattern": "^(|none|low|medium|high|xhigh|max)$",
          "title": "Reasoning Effort"
        },
        "ttl_minutes": {
          "type": "integer",
          "maximum": 720.0,
          "minimum": 15.0,
          "title": "Ttl Minutes"
        },
        "prompt": {
          "type": "string",
          "maxLength": 30000,
          "minLength": 50,
          "title": "Prompt"
        },
        "watchlist": {
          "type": "string",
          "maxLength": 5000,
          "title": "Watchlist"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "expected_revision",
        "enabled",
        "time",
        "provider",
        "model",
        "reasoning_effort",
        "ttl_minutes",
        "prompt",
        "watchlist"
      ],
      "title": "Update"
    }
  },
  "operational_ai_provider_property": {
    "anyOf": [
