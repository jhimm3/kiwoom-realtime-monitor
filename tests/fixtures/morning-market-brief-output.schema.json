{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "_Assessment": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "bullish",
            "bearish",
            "mixed",
            "uncertain"
          ],
          "type": "string"
        },
        "basis": {
          "const": "initial_hypothesis",
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        }
      },
      "required": [
        "state",
        "basis",
        "reason",
        "evidence_ids"
      ],
      "type": "object"
    },
    "_Calendar": {
      "additionalProperties": false,
      "properties": {
        "kr_session_status": {
          "enum": [
            "open",
            "closed",
            "unknown"
          ],
          "type": "string"
        },
        "us_session_status": {
          "enum": [
            "open",
            "closed",
            "unknown"
          ],
          "type": "string"
        },
        "kr_last_trading_date": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "kr_next_trading_date": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "us_last_trading_date": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        }
      },
      "required": [
        "kr_session_status",
        "us_session_status",
        "kr_last_trading_date",
        "kr_next_trading_date",
        "us_last_trading_date",
        "evidence_ids"
      ],
      "type": "object"
    },
    "_Concentration": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "single_leader",
            "theme_concentrated",
            "dispersed",
            "unknown"
          ],
          "type": "string"
        },
        "observation_scope": {
          "enum": [
            "last_completed_session",
            "external_proxy",
            "not_observed"
          ],
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        }
      },
      "required": [
        "state",
        "observation_scope",
        "reason",
        "evidence_ids"
      ],
      "type": "object"
    },
    "_Event": {
      "additionalProperties": false,
      "properties": {
        "event_key": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "type": "string"
        },
        "title": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "fact_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        },
        "interpretation": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "scope": {
          "enum": [
            "broad",
            "sector",
            "stock"
          ],
          "type": "string"
        },
        "direction": {
          "enum": [
            "positive",
            "negative",
            "mixed",
            "uncertain"
          ],
          "type": "string"
        },
        "importance": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ],
          "type": "string"
        },
        "importance_reason": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "novelty": {
          "enum": [
            "new",
            "developing",
            "recycled",
            "unknown"
          ],
          "type": "string"
        },
        "novelty_basis": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "persistence": {
          "$ref": "#/$defs/_Persistence"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        }
      },
      "required": [
        "event_key",
        "title",
        "fact_ids",
        "interpretation",
        "scope",
        "direction",
        "importance",
        "importance_reason",
        "novelty",
        "novelty_basis",
        "persistence",
        "evidence_ids"
      ],
      "type": "object"
    },
    "_Evidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "type": "string"
        },
        "url": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "publisher": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "official",
            "filing",
            "company_ir",
            "exchange",
            "media",
            "other"
          ],
          "type": "string"
        },
        "verification": {
          "enum": [
            "original_read",
            "secondary_only",
            "unverified"
          ],
          "type": "string"
        },
        "publisher_published_at": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_modified_at": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "published_date": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "timestamp_precision": {
          "enum": [
            "datetime",
            "date_only",
            "unknown"
          ],
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "url",
        "publisher",
        "source_kind",
        "verification",
        "publisher_published_at",
        "source_modified_at",
        "published_date",
        "timestamp_precision"
      ],
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "timestamp_precision": {
                "const": "datetime"
              }
            }
          },
          "then": {
            "properties": {
              "publisher_published_at": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "timestamp_precision": {
                "const": "date_only"
              }
            }
          },
          "then": {
            "properties": {
              "published_date": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        }
      ]
    },
    "_Fact": {
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "type": "string"
        },
        "statement": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "fact_status": {
          "enum": [
            "UNKNOWN",
            "RUMOR",
            "PROPOSED",
            "CONFIRMED",
            "AMENDED",
            "CANCELLED",
            "COMPLETED"
          ],
          "type": "string"
        },
        "event_occurred_at": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        }
      },
      "required": [
        "fact_id",
        "statement",
        "fact_status",
        "event_occurred_at",
        "observed_at",
        "evidence_ids"
      ],
      "type": "object"
    },
    "_Hypothesis": {
      "additionalProperties": false,
      "properties": {
        "hypothesis_key": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "type": "string"
        },
        "status": {
          "const": "UNCONFIRMED",
          "type": "string"
        },
        "statement": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "scope": {
          "enum": [
            "broad",
            "sector",
            "stock"
          ],
          "type": "string"
        },
        "direction": {
          "enum": [
            "positive",
            "negative",
            "mixed",
            "uncertain"
          ],
          "type": "string"
        },
        "event_keys": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "type": "array"
        },
        "theme_keys": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "stock_keys": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "confirming_signals": {
          "items": {
            "$ref": "#/$defs/_Signal"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array"
        },
        "contradicting_signals": {
          "items": {
            "$ref": "#/$defs/_Signal"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array"
        },
        "invalidation_conditions": {
          "items": {
            "$ref": "#/$defs/_Signal"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array"
        },
        "unknowns": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        }
      },
      "required": [
        "hypothesis_key",
        "status",
        "statement",
        "scope",
        "direction",
        "event_keys",
        "theme_keys",
        "stock_keys",
        "confirming_signals",
        "contradicting_signals",
        "invalidation_conditions",
        "unknowns"
      ],
      "type": "object"
    },
    "_Metric": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "US_SP500",
            "US_NASDAQ",
            "US_SOX",
            "KR_KOSPI",
            "KR_KOSDAQ",
            "NASDAQ_FUTURES",
            "USDKRW",
            "US10Y",
            "WTI"
          ],
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "change_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "enum": [
            "index",
            "KRW_per_USD",
            "percent",
            "USD_per_barrel"
          ],
          "type": "string"
        },
        "observed_at": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "trading_date": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "price_status": {
          "enum": [
            "final_close",
            "intraday",
            "unknown"
          ],
          "type": "string"
        },
        "timestamp_precision": {
          "enum": [
            "datetime",
            "trading_date",
            "unknown"
          ],
          "type": "string"
        },
        "availability_basis": {
          "enum": [
            "source_timestamp",
            "official_completed_session",
            "unverified"
          ],
          "type": "string"
        },
        "status": {
          "enum": [
            "confirmed",
            "delayed",
            "stale",
            "unavailable"
          ],
          "type": "string"
        },
        "instrument": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "market_venue": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "quote_type": {
          "enum": [
            "close",
            "spot",
            "futures",
            "yield"
          ],
          "type": "string"
        },
        "contract_month": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "comparison_basis": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        }
      },
      "required": [
        "id",
        "value",
        "change_pct",
        "unit",
        "observed_at",
        "trading_date",
        "price_status",
        "timestamp_precision",
        "availability_basis",
        "status",
        "instrument",
        "market_venue",
        "quote_type",
        "contract_month",
        "comparison_basis",
        "evidence_ids"
      ],
      "type": "object"
    },
    "_Participation": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "broad",
            "narrow",
            "mixed",
            "unknown"
          ],
          "type": "string"
        },
        "observation_scope": {
          "enum": [
            "last_completed_session",
            "external_proxy",
            "not_observed"
          ],
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        }
      },
      "required": [
        "state",
        "observation_scope",
        "reason",
        "evidence_ids"
      ],
      "type": "object"
    },
    "_Persistence": {
      "additionalProperties": false,
      "properties": {
        "horizon": {
          "enum": [
            "intraday",
            "short",
            "medium",
            "unknown"
          ],
          "type": "string"
        },
        "mechanism": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "assumptions": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "review_due_at": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "horizon",
        "mechanism",
        "assumptions",
        "review_due_at"
      ],
      "type": "object"
    },
    "_Signal": {
      "additionalProperties": false,
      "properties": {
        "data_source": {
          "enum": [
            "TOP20",
            "TURNOVER",
            "PRICE",
            "TRADES",
            "THEME_COHERENCE",
            "NEWS_REVISION",
            "MARKET_INDEX",
            "CALENDAR"
          ],
          "type": "string"
        },
        "target_ref": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "type": "string"
        },
        "observation": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "expected_change": {
          "enum": [
            "increase",
            "decrease",
            "hold",
            "reverse",
            "appear",
            "disappear",
            "confirm",
            "cancel",
            "unknown"
          ],
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        }
      },
      "required": [
        "data_source",
        "target_ref",
        "observation",
        "expected_change",
        "evidence_ids"
      ],
      "type": "object"
    },
    "_Stock": {
      "additionalProperties": false,
      "properties": {
        "stock_key": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "type": "string"
        },
        "security_name": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "code": {
          "anyOf": [
            {
              "pattern": "^\\d{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "security_id": {
          "type": "null"
        },
        "market": {
          "enum": [
            "KR",
            "US",
            "other",
            "unknown"
          ],
          "type": "string"
        },
        "relation_type": {
          "enum": [
            "direct",
            "indirect",
            "uncertain"
          ],
          "type": "string"
        },
        "relation_source": {
          "enum": [
            "explicit_article",
            "filing",
            "inferred"
          ],
          "type": "string"
        },
        "status": {
          "const": "proposed",
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "event_keys": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "type": "array"
        },
        "theme_keys": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "contradicting_evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        }
      },
      "required": [
        "stock_key",
        "security_name",
        "code",
        "security_id",
        "market",
        "relation_type",
        "relation_source",
        "status",
        "reason",
        "event_keys",
        "theme_keys",
        "evidence_ids",
        "contradicting_evidence_ids"
      ],
      "type": "object"
    },
    "_Theme": {
      "additionalProperties": false,
      "properties": {
        "theme_key": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "type": "string"
        },
        "name": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "industry",
            "market_theme",
            "event_specific_basket"
          ],
          "type": "string"
        },
        "relation_source": {
          "enum": [
            "explicit_article",
            "filing",
            "inferred"
          ],
          "type": "string"
        },
        "status": {
          "const": "proposed",
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "event_keys": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "contradicting_evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        }
      },
      "required": [
        "theme_key",
        "name",
        "kind",
        "relation_source",
        "status",
        "reason",
        "event_keys",
        "evidence_ids",
        "contradicting_evidence_ids"
      ],
      "type": "object"
    },
    "_Unknown": {
      "additionalProperties": false,
